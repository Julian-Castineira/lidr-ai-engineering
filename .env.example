# Copia este fichero a .env y rellena tu clave. .env está en .gitignore: nunca lo subas.

# Clave de la API de Anthropic (https://platform.claude.com/settings/keys). Obligatoria.
ANTHROPIC_API_KEY=

# Modelo por defecto. claude-haiku-5-5 es el Haiku vigente.
LLM_MODEL=claude-haiku-5-5

# Temperatura (0-1). Déjala vacía con claude-haiku-5-5: ese modelo rechaza (400) cualquier
# valor distinto de 1. Además, la versión de API que envía el SDK (2026-10-21) la rechaza en
# todos los modelos: solo tiene efecto con claude-haiku-4-5 y la API 2023-06-01 (experimentos).
LLM_TEMPERATURE=

# Esfuerzo de razonamiento: low | medium | high | xhigh | max. Vacío = valor por defecto
# del modelo (medium en claude-haiku-5-5). No lo admite claude-haiku-4-5.
LLM_EFFORT=

# Límite de tokens de salida. En claude-haiku-5-5 incluye los tokens de razonamiento.
LLM_MAX_TOKENS=4096

# Timeout por petición (segundos) y reintentos del SDK ante errores transitorios.
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# Modelo legacy, solo para los experimentos de temperature, top_p, top_k y budget_tokens.
LLM_LEGACY_MODEL=claude-haiku-4-5-20251001

# Versión de API para las llamadas al modelo legacy. La versión que envía el SDK (2026-10-21)
# elimina temperature, top_p y top_k en todos los modelos; 2023-06-01 aún los admite.
LLM_LEGACY_API_VERSION=2023-06-01

# Override opcional de la tabla de precios (USD por millón de tokens). Ejemplo:
# LLM_PRICING_JSON={"mi-modelo": {"tiers": [{"max_prompt_tokens": null, "input": 1, "output": 5, "cache_write": 1.25, "cache_read": 0.1}]}}
LLM_PRICING_JSON=

# Proveedor de LLM. Solo admite anthropic hasta que la Sesión 3 añada otros proveedores.
LLM_PROVIDER=anthropic

# --- Servicio HTTP (estimador CAG) ---

# Entorno: development | test | production. Se muestra en GET /health.
APP_ENV=development

# Nivel de registro de la aplicación: DEBUG | INFO | WARNING | ERROR | CRITICAL. Los registros del
# SDK y del cliente HTTP se mantienen en WARNING con cualquier nivel: a DEBUG incluirían el cuerpo
# de las peticiones, con la transcripción.
LOG_LEVEL=INFO

# Tarifas en EUR/h por rol (JSON). Los ejemplos del contexto calculan sus costes con ellas y
# todos sus roles deben tener tarifa. Vacío = valores por defecto, que son estos:
# ESTIMATION_HOURLY_RATES={"desarrollo": 62.50, "diseño": 50.00, "gestión": 55.00, "QA": 45.00}
ESTIMATION_HOURLY_RATES=

# Longitud máxima de la transcripción en caracteres (mínimo 50). 60.000 ≈ 15.000 tokens.
ESTIMATION_MAX_TRANSCRIPTION_CHARS=60000
